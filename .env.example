# config.yml defaults to Gemini matching. Set matching.provider: none for local-only scoring,
# or claude to use Anthropic. Configure the matching provider in config.yml.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Store plain-text resume content in a secret/environment variable, never commit a resume.
RESUME_TEXT=
# Local only: point to an ignored PDF/text file; Actions should use RESUME_TEXT secret.
RESUME_FILE=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
