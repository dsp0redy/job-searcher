# Keep matching.provider: none for local keyword scoring.
# To enable AI matching, set matching.provider to gemini or claude in config.yml.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Store plain-text resume content in a secret/environment variable, never commit a resume.
RESUME_TEXT=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
