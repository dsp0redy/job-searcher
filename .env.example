# Provider defaults should match .github/workflows/scan.yml.
# Set AI_PROVIDER to gemini (default), claude, openai_compatible, or none.
AI_PROVIDER=gemini

# Gemini provider (used by default).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude provider; set AI_PROVIDER=claude to use it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# OpenAI-compatible provider; set AI_PROVIDER=openai_compatible to use it.
# Examples: https://api.groq.com/openai/v1 or https://openrouter.ai/api/v1
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Store plain-text resume content in a GitHub Actions Secret or local environment.
# Never commit a resume or paste it into config.yml.
RESUME_TEXT=
# Local only: path to an ignored PDF/text file; Actions should use RESUME_TEXT.
RESUME_FILE=

# Optional for local issue publishing. GitHub Actions provides these automatically.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
